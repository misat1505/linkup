{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "start": "prisma db push && cross-env NODE_ENV=production node ./build/app.js",
    "build": "tsup",
    "dev": "prisma db push && cross-env NODE_ENV=development tsx watch --clear-screen=false src/app.ts",
    "e2e": "prisma db push && cross-env NODE_ENV=e2e tsx watch --clear-screen=false src/app.ts",
    "test": "concurrently -n \"unit,integration\" -c \"yellow,magenta\" \"pnpm test:unit\" \"pnpm test:integration\"",
    "test:unit": "pnpm vitest run --project unit",
    "test:integration": "pnpm vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:load": "artillery run ./tests/load-tests/test.yaml",
    "pretest:load:report": "mkdirp ./load-tests-report",
    "test:load:report": "artillery run --output ./load-tests-report/test-result.json ./tests/load-tests/test.yaml && artillery report ./load-tests-report/test-result.json",
    "docs:generate": "typedoc",
    "lint": "eslint src/ tests/"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@packages/api-contract": "workspace:*",
    "@packages/schemas": "workspace:*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/node": "^10.53.0",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-status-monitor": "^1.3.4",
    "http-status-codes": "^2.3.0",
    "i18next": "^26.1.0",
    "i18next-fs-backend": "^2.6.5",
    "i18next-http-middleware": "^3.9.6",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "sharp": "^0.34.5",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/body-parser": "^1.19.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-status-monitor": "^1.3.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.7.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.6",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.3.0",
    "lint-staged": "^17.0.4",
    "mkdirp": "^3.0.1",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-inline-sources": "^1.3.0",
    "typedoc-theme-hierarchy": "^6.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6"
  }
}
