{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"target": "esnext",
		"module": "node16",
		"moduleResolution": "node16",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"outDir": "build",
		"rootDir": "."
	},
	"include": ["src", "tests"]
}
